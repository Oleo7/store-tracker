APP_ENV=development
SHEET_KEY=
PRODUCTION_SHEET_KEY=
STAGING_SHEET_KEY=
WEB_CONCURRENCY=1
APP_INSTANCE_COUNT=1
PERFORMANCE_LOGGING_ENABLED=false
GOOGLE_MAPS_API_KEY=
# Backend-only key with Google Routes API enabled. Keep separate from the
# browser key above; fallback to GOOGLE_MAPS_API_KEY is not recommended in prod.
GOOGLE_ROUTES_API_KEY=
ROUTE_ROUTING_PREFERENCE=TRAFFIC_AWARE
ROUTE_MATRIX_TIMEOUT_SECONDS=15
ROUTE_MATRIX_CACHE_TTL_SECONDS=600
ROUTE_MATRIX_CANDIDATE_LIMIT=60
# Google Route Optimization v1 is opt-in; legacy remains the safe default.
ROUTE_ENGINE=legacy
ROUTE_OPTIMIZATION_PROJECT=
# Dedicated service-account JSON; never shared with Sheets credentials.
ROUTE_OPTIMIZATION_GOOGLE_CREDENTIALS=
ROUTE_OPTIMIZATION_WEEKLY_OWNER_LIMIT=2
ROUTE_OPTIMIZATION_WEEKLY_TEAM_LIMIT=6
ROUTE_OPTIMIZATION_CACHE_SECONDS=1800
ROUTE_OPTIMIZATION_TIMEOUT_SECONDS=90
ROUTE_OPTIMIZATION_FIXED_TIMEOUT_SECONDS=180
GOOGLE_CREDENTIALS=
BREVO_API_KEY=
FLASK_SECRET_KEY=
BREVO_WEBHOOK_SECRET=
EMAIL_SEND_MODE=test
EMAIL_TEST_RECIPIENT=olle@eatpolarbar.com
# Optional HTTPS directory for email images, for example https://crm.example.com/images.
# If omitted on Render, the app uses Render's automatic RENDER_EXTERNAL_URL + /images.
EMAIL_ASSET_BASE_URL=
BREVO_RECONCILE_INTERVAL_SECONDS=900
BREVO_RECONCILE_DAYS=3
BREVO_RECONCILE_MAX_RECIPIENTS=100
# Customer master reconciliation runs after production order_rows writes.
# Keep dry_run until the live reconciliation report has been reviewed.
CRM_CUSTOMER_SYNC_MODE=dry_run
# Incremental Stockfiller runs also refetch recently created orders so delayed
# customer-number assignments converge even if updatedDateTime is unchanged.
STOCKFILLER_CREATED_REFRESH_DAYS=45
